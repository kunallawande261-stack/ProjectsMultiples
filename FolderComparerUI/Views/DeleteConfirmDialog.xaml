<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FolderComparerUI.Views.DeleteConfirmDialog"
        Title="Confirm Delete"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20">

        <!-- Info text populated from code-behind -->
        <TextBlock x:Name="txtInfo" TextWrapping="Wrap" Margin="0,0,0,16" FontSize="13"/>

        <!-- Recycle Bin option — shown only for Delete (not dry-run) -->
        <CheckBox x:Name="chkRecycle"
                  Content="Send deleted files to Recycle Bin (safer)"
                  IsChecked="True"
                  Margin="0,0,0,20"
                  FontSize="13"/>

        <!-- Action buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnDelete"  Content="Delete"   Width="90" Height="30"
                    Margin="0,0,10,0"  Click="BtnDelete_Click"/>
            <Button x:Name="btnDryRun" Content="Dry-run"  Width="90" Height="30"
                    Margin="0,0,10,0"  Click="BtnDryRun_Click"/>
            <Button x:Name="btnCancel" Content="Cancel"   Width="90" Height="30"
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
