<mah:MetroWindow x:Class="FolderComparerUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:conv="clr-namespace:FolderComparerUI.Converters"
    xmlns:vm="clr-namespace:FolderComparerUI.ViewModels"
    mc:Ignorable="d"
    Title="Folder Comparer"
    Height="720" Width="1100"
    FontFamily="Segoe UI"
    WindowStartupLocation="CenterScreen"
    GlowBrush="DodgerBlue"
    BorderThickness="0"
    Topmost="{Binding Topmost}"
    Loaded="MetroWindow_Loaded"
    Closing="MetroWindow_Closing"
    StateChanged="MetroWindow_StateChanged"
    SizeChanged="MetroWindow_SizeChanged">

    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="F5"     Command="{Binding AnalyzeCommand}"/>
        <KeyBinding Key="R"      Command="{Binding ReloadCommand}"      Modifiers="Ctrl"/>
        <KeyBinding Key="E"      Command="{Binding ExportExcelCommand}" Modifiers="Ctrl"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </mah:MetroWindow.InputBindings>

    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal">
                <Border Background="White" CornerRadius="2" Margin="1">
                    <Image Source="/Assets/icon.ico" Width="24" Height="24"/>
                </Border>
                <TextBlock Text="{Binding}" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0"/>
            </StackPanel>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>

    <mah:MetroWindow.Resources>
        <conv:CategoryToSymbolConverter  x:Key="CategoryToSymbol"/>
        <conv:StringToVisibilityConverter x:Key="StrToVis"/>
        <conv:StringToBrushConverter     x:Key="StrToBrush"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#5E6B78"/>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height"      Value="30"/>
            <Setter Property="Padding"     Value="10,0"/>
            <Setter Property="Background"  Value="#1E5C9B"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#174A82"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height"      Value="30"/>
            <Setter Property="Padding"     Value="10,0"/>
            <Setter Property="Background"  Value="#EFF5FB"/>
            <Setter Property="Foreground"  Value="#1A3A5C"/>
            <Setter Property="BorderBrush" Value="#C4D8EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>

        <Style x:Key="PathInputStyle" TargetType="TextBox">
            <Setter Property="Height"      Value="30"/>
            <Setter Property="Padding"     Value="8,0"/>
            <Setter Property="BorderBrush" Value="#C9D8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ExplorerIconButtonStyle" TargetType="Button">
            <Setter Property="Width"       Value="28"/>
            <Setter Property="Height"      Value="28"/>
            <Setter Property="Margin"      Value="5,0,0,0"/>
            <Setter Property="Padding"     Value="0"/>
            <Setter Property="Background"  Value="#EBF2FA"/>
            <Setter Property="Foreground"  Value="#1A3A5C"/>
            <Setter Property="BorderBrush" Value="#BACED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <Style x:Key="TopToolButtonStyle" TargetType="Button">
            <Setter Property="Height"    Value="28"/>
            <Setter Property="MinWidth"  Value="72"/>
            <Setter Property="Margin"    Value="0,0,4,0"/>
            <Setter Property="Padding"   Value="10,0"/>
            <Setter Property="Background"  Value="#EAF2FB"/>
            <Setter Property="Foreground"  Value="#1E3D5C"/>
            <Setter Property="BorderBrush" Value="#BFD2E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"    Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlyoutToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height"    Value="28"/>
            <Setter Property="MinWidth"  Value="78"/>
            <Setter Property="Margin"    Value="0,0,5,0"/>
            <Setter Property="Padding"   Value="10,0"/>
            <Setter Property="Background"  Value="#F2F7FD"/>
            <Setter Property="Foreground"  Value="#1E3D5C"/>
            <Setter Property="BorderBrush" Value="#C7D8EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"    Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CatCheckStyle" TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin"  Value="0,0,0,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </mah:MetroWindow.Resources>

    <Border CornerRadius="10" BorderThickness="2" Margin="8" SnapsToDevicePixels="True">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4A97DA" Offset="0"/>
                <GradientStop Color="#2E73B5" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <DockPanel>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 1  —  Flyout toggle buttons
                 ═══════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top"
                    Background="#D8E8F5" BorderBrush="#B8CCDE" BorderThickness="0,0,0,1"
                    Padding="8,5">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="btnOptionsFlyout" Content="⚙ Options" Style="{StaticResource FlyoutToggleStyle}"/>
                        <ToggleButton x:Name="btnCopyFlyout"    Content="⧉ Copy"    Style="{StaticResource FlyoutToggleStyle}"/>
                        <ToggleButton x:Name="btnDeleteFlyout"  Content="⊟ Delete"  Style="{StaticResource FlyoutToggleStyle}"/>
                        <ToggleButton x:Name="btnExcelFlyout"   Content="▦ Excel"   Style="{StaticResource FlyoutToggleStyle}"/>
                    </StackPanel>

                    <!-- OPTIONS popup -->
                    <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=btnOptionsFlyout}"
                           IsOpen="{Binding IsChecked, ElementName=btnOptionsFlyout, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#BFD2E7" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" MinWidth="640">
                            <StackPanel>
                                <TextBlock Text="Options" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#1A3A5C" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <CheckBox Content="Enable logging"                      Margin="0,0,16,8" IsChecked="{Binding EnableLogging}"/>
                                    <CheckBox Content="Smart XML compare (.xml .aml .svg)"  Margin="0,0,16,8" IsChecked="{Binding SmartXml}"/>
                                    <CheckBox Content="Keep window topmost"                 Margin="0,0,16,8" IsChecked="{Binding Topmost}"/>
                                    <CheckBox Content="Force re-read (ignore cache)"         Margin="0,0,16,8" IsChecked="{Binding ForceReread}"/>
                                    <TextBlock Text="Compare mode:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <ComboBox Width="220" Margin="0,0,0,8" SelectedValuePath="Tag" SelectedValue="{Binding CompareModeTag}">
                                        <ComboBoxItem Tag="Normal">Normal (size + hash)</ComboBoxItem>
                                        <ComboBoxItem Tag="HashOnly">Hash only (always hash)</ComboBoxItem>
                                    </ComboBox>
                                </WrapPanel>
                                <DockPanel Margin="0,4,0,0"
                                           Visibility="{Binding LogPathVisibility, Converter={StaticResource StrToVis}}">
                                    <TextBlock Text="Log path:" Width="80" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtLogPath" Width="320" Margin="0,0,8,0"
                                             Style="{StaticResource PathInputStyle}"
                                             Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}"
                                             AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver" Drop="TextBox_Drop"/>
                                    <Button Content="..." Width="42" Command="{Binding BrowseLogCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"/>
                                </DockPanel>
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="Beyond Compare:" Width="120" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtBcPath" Width="240" Margin="0,0,8,0"
                                             Style="{StaticResource PathInputStyle}"
                                             Text="{Binding BcPath, UpdateSourceTrigger=PropertyChanged}"
                                             AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver" Drop="TextBox_Drop"/>
                                    <Button Content="..."   Width="40" Margin="0,0,5,0" Command="{Binding BrowseBcPathCommand}" Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    <Button Content="Save"  Width="52" Margin="0,0,5,0" Command="{Binding SaveBcPathCommand}"   Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    <Button Content="Clear" Width="52" Margin="0,0,8,0" Command="{Binding ClearBcPathCommand}"  Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="11"
                                               Text="{Binding BcStatusText}"
                                               Foreground="{Binding BcStatusForeground, Converter={StaticResource StrToBrush}}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- COPY popup -->
                    <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=btnCopyFlyout}"
                           IsOpen="{Binding IsChecked, ElementName=btnCopyFlyout, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#BFD2E7" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" MinWidth="600">
                            <StackPanel>
                                <ComboBox Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                                          SelectedValuePath="Tag" SelectedValue="{Binding ModeTag}">
                                    <ComboBoxItem Tag="3">Copy</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Text="Copy files" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#1A3A5C" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Target set:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" Margin="0,0,8,0" SelectedValuePath="Tag" SelectedValue="{Binding TargetTag}">
                                        <ComboBoxItem Tag="2">Left-Orphans</ComboBoxItem>
                                        <ComboBoxItem Tag="3">Right-Orphans</ComboBoxItem>
                                        <ComboBoxItem Tag="4L">Different — Left folder only</ComboBoxItem>
                                        <ComboBoxItem Tag="4R">Different — Right folder only</ComboBoxItem>
                                        <ComboBoxItem Tag="5">All sets</ComboBoxItem>
                                        <ComboBoxItem Tag="1">Same</ComboBoxItem>
                                        <ComboBoxItem Tag="CL">Copy entire Left folder</ComboBoxItem>
                                        <ComboBoxItem Tag="CR">Copy entire Right folder</ComboBoxItem>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="Start"  Width="88" Margin="0,0,6,0"
                                            Command="{Binding StartCommand}" Style="{StaticResource PrimaryActionButtonStyle}"/>
                                    <Button Grid.Column="3" Content="Cancel" Width="88"
                                            Command="{Binding CancelCommand}" Style="{StaticResource SecondaryActionButtonStyle}"/>
                                </Grid>
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="Copy destination:" Width="110" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtExportPath" Width="330" Margin="0,0,8,0"
                                             Style="{StaticResource PathInputStyle}"
                                             Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}"
                                             AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver" Drop="TextBox_Drop"/>
                                    <Button Content="..." Width="42" Command="{Binding BrowseExportCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"/>
                                </DockPanel>
                                <CheckBox Content="Create category subfolders" Margin="0,10,0,0"
                                          IsChecked="{Binding CategorySubfolders}"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- DELETE popup -->
                    <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=btnDeleteFlyout}"
                           IsOpen="{Binding IsChecked, ElementName=btnDeleteFlyout, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#BFD2E7" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" MinWidth="600">
                            <StackPanel>
                                <ComboBox Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                                          SelectedValuePath="Tag" SelectedValue="{Binding ModeTag}">
                                    <ComboBoxItem Tag="2">Delete</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Text="Delete files" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#1A3A5C" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Target set:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" Margin="0,0,8,0" SelectedValuePath="Tag" SelectedValue="{Binding TargetTag}">
                                        <ComboBoxItem Tag="2">Left-Orphans</ComboBoxItem>
                                        <ComboBoxItem Tag="3">Right-Orphans</ComboBoxItem>
                                        <ComboBoxItem Tag="4">Different (both sides)</ComboBoxItem>
                                        <ComboBoxItem Tag="4L">Different — Left folder only</ComboBoxItem>
                                        <ComboBoxItem Tag="4R">Different — Right folder only</ComboBoxItem>
                                        <ComboBoxItem Tag="5">All sets</ComboBoxItem>
                                        <ComboBoxItem Tag="1">Same (both sides)</ComboBoxItem>
                                        <ComboBoxItem Tag="1L">Same — Left folder only</ComboBoxItem>
                                        <ComboBoxItem Tag="1R">Same — Right folder only</ComboBoxItem>
                                    </ComboBox>
                                    <CheckBox Grid.Column="2" Content="Keep root if empty" VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              IsChecked="{Binding KeepRoot}"
                                              Visibility="{Binding KeepRootVisibility, Converter={StaticResource StrToVis}}"/>
                                    <Button Grid.Column="3" Content="Start"  Width="88" Margin="0,0,6,0"
                                            Command="{Binding StartCommand}" Style="{StaticResource PrimaryActionButtonStyle}"/>
                                    <Button Grid.Column="4" Content="Cancel" Width="88"
                                            Command="{Binding CancelCommand}" Style="{StaticResource SecondaryActionButtonStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- EXCEL popup -->
                    <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=btnExcelFlyout}"
                           IsOpen="{Binding IsChecked, ElementName=btnExcelFlyout, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#BFD2E7" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" MinWidth="560">
                            <StackPanel>
                                <TextBlock Text="Export to Excel" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#1A3A5C" Margin="0,0,0,10"/>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Excel path:" Width="76" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtExcelPath" Width="330" Margin="0,0,8,0"
                                             Style="{StaticResource PathInputStyle}"
                                             Text="{Binding ExcelPath, UpdateSourceTrigger=PropertyChanged}"
                                             AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver" Drop="TextBox_Drop"/>
                                    <Button Content="..." Width="42" Command="{Binding BrowseExcelCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"/>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" Margin="0,0,14,0" SelectedValuePath="Tag" SelectedValue="{Binding ExcelCategoryTag}">
                                        <ComboBoxItem Tag="1">Same</ComboBoxItem>
                                        <ComboBoxItem Tag="2">Left-Orphans</ComboBoxItem>
                                        <ComboBoxItem Tag="3">Right-Orphans</ComboBoxItem>
                                        <ComboBoxItem Tag="4">Different</ComboBoxItem>
                                        <ComboBoxItem Tag="5">All</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Grid.Column="2" Text="Sheet name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="3" Margin="0,0,10,0" Style="{StaticResource PathInputStyle}"
                                             MaxLength="31" Text="{Binding SheetName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="4" Content="Export" Width="90"
                                            Command="{Binding ExportExcelCommand}"
                                            Style="{StaticResource PrimaryActionButtonStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 2  —  Action buttons  +  View / Exclude  (inline)
                 ═══════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top"
                    Background="#EAF1F9" BorderBrush="#C5D5E5" BorderThickness="0,0,0,1"
                    Padding="8,5">
                <DockPanel LastChildFill="False">
                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="▶ Start"   Command="{Binding AnalyzeCommand}"     Style="{StaticResource TopToolButtonStyle}"/>
                        <Button Content="↺ Reload"  Command="{Binding ReloadCommand}"      Style="{StaticResource TopToolButtonStyle}"/>
                        <Button Content="↗ Excel"   Command="{Binding ExportExcelCommand}" Style="{StaticResource TopToolButtonStyle}"/>
                        <Button Content="✕ Cancel"  Command="{Binding CancelCommand}"      Style="{StaticResource TopToolButtonStyle}"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border DockPanel.Dock="Left" Width="1" Background="#BDD0E2" Margin="6,3"/>

                    <!-- View (dropdown) moved to the search-button position and Search button moved to previous view position.
                         Dropdown supports multiple selections (check boxes bound to existing Show* properties). -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        
<!-- SEARCH button moved to the previous View combobox position -->
<Button Content="🔍" Width="32" Height="26" Margin="8,0,0,0" Padding="0"
        Command="{Binding AnalyzeCommand}"
        Background="#EAF2FB" BorderBrush="#BFD2E7" BorderThickness="1" Cursor="Hand"/>
                        <!-- Filter text box -->
                        <TextBox Width="155" Height="26" Padding="6,0" VerticalContentAlignment="Center"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter all columns (relative path / category)"
                                 BorderBrush="#C9D8E8" BorderThickness="1"/>
                        <TextBlock Text="View:" VerticalAlignment="Center" Foreground="#2C4966"
            FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0"/>
                        <!-- VIEW dropdown (was where the search icon used to be) -->
                        <ToggleButton x:Name="btnViewDrop" Width="32" Height="26" Margin="6,0,0,0"
                                      Padding="0" Content="▾" Cursor="Hand" Background="#EAF2FB" BorderBrush="#BFD2E7"
                                      BorderThickness="1"/>
                        <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=btnViewDrop}"
                               IsOpen="{Binding IsChecked, ElementName=btnViewDrop, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#BFD2E7" BorderThickness="1" CornerRadius="6" Padding="10" MinWidth="200">
                                <StackPanel>
                                    <TextBlock Text="View filter" FontWeight="SemiBold" Foreground="#1A3A5C" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Vertical">
                                        <CheckBox Content="Same"       IsChecked="{Binding ShowSame}"        Style="{StaticResource CatCheckStyle}"/>
                                        <CheckBox Content="Different"  IsChecked="{Binding ShowDifferent}"   Style="{StaticResource CatCheckStyle}"/>
                                        <CheckBox Content="Left only"  IsChecked="{Binding ShowLeftOrphan}"  Style="{StaticResource CatCheckStyle}"/>
                                        <CheckBox Content="Right only" IsChecked="{Binding ShowRightOrphan}" Style="{StaticResource CatCheckStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <TextBlock Text="Exclude:" VerticalAlignment="Center" Foreground="#2C4966"
                                   FontSize="11" FontWeight="SemiBold" Margin="10,0,5,0"/>
                        <TextBox Width="155" Height="26" Padding="6,0" VerticalContentAlignment="Center"
                                 Text="{Binding ExcludePatterns, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Exclude patterns: .ext  folder  *.tmp"
                                 BorderBrush="#C9D8E8" BorderThickness="1"/>

                        <Button Content="✕ Clear" Command="{Binding ClearFilterCommand}"
                                Margin="8,0,0,0" Height="26" Padding="8,0"
                                Background="#F5E0E0" Foreground="#8B1A1A"
                                BorderBrush="#D9AAAA" BorderThickness="1"
                                FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                Visibility="{Binding FilterHasText, Converter={StaticResource StrToVis}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 BOTTOM  —  Status bar
                 ═══════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom"
                    Background="#F6FAFE" BorderBrush="#D3E3F2" BorderThickness="0,1,0,0"
                    Padding="10,5">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Left" Width="220" Height="14" Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"/>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource SubtleTextBrush}" Margin="12,0,0,0"
                               Text="{Binding ResultCountText}"/>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#2F4D68"
                               Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 MAIN CONTENT
                 ═══════════════════════════════════════════════════════ -->
            <Grid Margin="10,8,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <!-- Results area -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Folder paths  -->
                        <RowDefinition Height="Auto"/>
                        <!-- (REMOVED) previously category checkboxes + per-column search -->
                        <RowDefinition Height="Auto"/>
                        <!-- Column headers -->
                        <RowDefinition Height="*"/>
                        <!-- ListView -->
                    </Grid.RowDefinitions>

                    <!-- ── ROW 3: Folder path selectors ── -->
                    <Border Grid.Row="0"
                            Background="#F2F8FF" BorderBrush="#C8D7E8" BorderThickness="1"
                            CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="Left:" VerticalAlignment="Center"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#2C4966" Margin="0,0,6,0"/>
                                <Button DockPanel.Dock="Right" Content="..." Command="{Binding BrowseLeftCommand}"
                                        Style="{StaticResource ExplorerIconButtonStyle}"/>
                                <TextBox x:Name="txtLeft" Style="{StaticResource PathInputStyle}"
                                         Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}"
                                         AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver" Drop="TextBox_Drop"
                                         ToolTip="{Binding LeftPath}"/>
                            </DockPanel>

                            <TextBlock Grid.Column="1" Text="⟷" FontSize="16" Foreground="#6A95BB"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <DockPanel Grid.Column="2" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="Right:" VerticalAlignment="Center"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#2C4966" Margin="0,0,6,0"/>
                                <Button DockPanel.Dock="Right" Content="..." Command="{Binding BrowseRightCommand}"
                                        Style="{StaticResource ExplorerIconButtonStyle}"/>
                                <TextBox x:Name="txtRight" Style="{StaticResource PathInputStyle}"
                                         Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}"
                                         AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver" Drop="TextBox_Drop"
                                         ToolTip="{Binding RightPath}"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- ── Column header bar ── -->
                    <Grid Grid.Row="2">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#2A6EAC" Offset="0"/>
                                <GradientStop Color="#225D93" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnSortLeft" Grid.Column="0"
                                Content="{Binding SortLeftHeader}" Command="{Binding SortLeftCommand}"
                                Height="32" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                Background="Transparent" BorderThickness="0,0,1,0" BorderBrush="#4E88BD"
                                HorizontalContentAlignment="Left" Padding="10,0"/>

                        <Button x:Name="btnSortCategory" Grid.Column="1"
                                Content="{Binding SortCategoryHeader}" Command="{Binding SortCategoryCommand}"
                                Height="32" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                Background="Transparent" BorderThickness="1,0,1,0" BorderBrush="#4E88BD"
                                HorizontalContentAlignment="Center"/>

                        <Button x:Name="btnSortRight" Grid.Column="2"
                                Content="{Binding SortRightHeader}" Command="{Binding SortRightCommand}"
                                Height="32" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                Background="Transparent" BorderThickness="1,0,0,0" BorderBrush="#4E88BD"
                                HorizontalContentAlignment="Left" Padding="10,0"/>
                    </Grid>

                    <!-- ── Results ListView ── -->
                    <ListView Grid.Row="3" x:Name="lvResults"
                              ItemsSource="{Binding ResultItems}"
                              SelectedItem="{Binding SelectedRow}"
                              BorderThickness="1" BorderBrush="#CADBEC"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ContextMenuOpening="LvResults_ContextMenuOpening"
                              SelectionChanged="lvResults_SelectionChanged"
                              Background="White">

                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment"   Value="Center"/>
                                <Setter Property="Padding"         Value="0"/>
                                <Setter Property="Margin"          Value="0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush"     Value="#E6EEF7"/>
                                <Setter Property="MinHeight"       Value="32"/>
                                <Setter Property="Background"      Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#ECF5FF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush"     Value="#1E5C9B"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="0,1,0,1"/>
                                                    <Setter TargetName="Bd" Property="Background"      Value="#DCEEFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Open Left in Explorer"        Name="ctxOpenLeftExplorer"/>
                                            <MenuItem Header="Open Right in Explorer"       Name="ctxOpenRightExplorer"/>
                                            <Separator/>
                                            <MenuItem Header="Open Left in Beyond Compare"  Name="ctxBcLeft"/>
                                            <MenuItem Header="Open Right in Beyond Compare" Name="ctxBcRight"/>
                                            <MenuItem Header="Compare in Beyond Compare"    Name="ctxBcCompare"/>
                                            <Separator Name="ctxActionSep"/>
                                            <MenuItem Header="Copy to Right"   Name="ctxCopyToRight"/>
                                            <MenuItem Header="Copy to Left"    Name="ctxCopyToLeft"/>
                                            <Separator Name="ctxDeleteSep"/>
                                            <MenuItem Header="Delete Left"     Name="ctxDeleteLeft"/>
                                            <MenuItem Header="Delete Right"    Name="ctxDeleteRight"/>
                                            <MenuItem Header="Delete Both"     Name="ctxDeleteBoth"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Category}" Value="Same">
                                        <Setter Property="Background" Value="#F0FAF1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Different">
                                        <Setter Property="Background" Value="#FFF8F0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Left-Orphan">
                                        <Setter Property="Background" Value="#F0F6FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Right-Orphan">
                                        <Setter Property="Background" Value="#F6F2FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*" MinWidth="200"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="#E0EAF5" BorderThickness="0,0,1,0" Padding="10,6">
                                        <TextBlock Text="{Binding LeftFull}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   VerticalAlignment="Center" FontSize="12" Foreground="#2C3E50"
                                                   ToolTip="{Binding LeftFull}"/>
                                    </Border>

                                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            CornerRadius="10" Padding="8,3" Margin="4,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"      Value="#E0E0E0"/>
                                                <Setter Property="BorderBrush"     Value="#BDBDBD"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="Same">
                                                        <Setter Property="Background"  Value="#E8F5E9"/>
                                                        <Setter Property="BorderBrush" Value="#A5D6A7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="Different">
                                                        <Setter Property="Background"  Value="#FFF3E0"/>
                                                        <Setter Property="BorderBrush" Value="#FFCC80"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="Left-Orphan">
                                                        <Setter Property="Background"  Value="#E3F2FD"/>
                                                        <Setter Property="BorderBrush" Value="#90CAF9"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="Right-Orphan">
                                                        <Setter Property="Background"  Value="#EDE7F6"/>
                                                        <Setter Property="BorderBrush" Value="#CE93D8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontSize="11" FontWeight="SemiBold" ToolTip="{Binding Category}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="?"/>
                                                    <Setter Property="Foreground" Value="#616161"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Category}" Value="Same">
                                                            <Setter Property="Text"       Value="= Same"/>
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category}" Value="Different">
                                                            <Setter Property="Text"       Value="!= Diff"/>
                                                            <Setter Property="Foreground" Value="#E65100"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category}" Value="Left-Orphan">
                                                            <Setter Property="Text"       Value="Left only"/>
                                                            <Setter Property="Foreground" Value="#1565C0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category}" Value="Right-Orphan">
                                                            <Setter Property="Text"       Value="Right only"/>
                                                            <Setter Property="Foreground" Value="#6A1B9A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <Border Grid.Column="2" BorderBrush="#E0EAF5" BorderThickness="1,0,0,0" Padding="10,6">
                                        <TextBlock Text="{Binding RightFull}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   VerticalAlignment="Center" FontSize="12" Foreground="#2C3E50"
                                                   ToolTip="{Binding RightFull}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty-state overlay -->
                    <Border Grid.Row="3" IsHitTestVisible="False" Margin="20"
                            Background="#F7FBFF" BorderBrush="#D3E2F0" BorderThickness="1" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=lvResults, Path=HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <TextBlock Text="No comparison results yet"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="#31516F" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select left and right folders, then click ▶ Start."
                                       Margin="0,6,0,0" FontSize="12"
                                       Foreground="#5E6B78" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Splitter -->
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" Background="#C9D9EA" ShowsPreview="True"/>

                <!-- Log panel -->
                <TextBox Grid.Row="2" x:Name="txtLog"
                         Text="{Binding LogText, Mode=OneWay}"
                         VerticalAlignment="Stretch"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Margin="0,6,0,0" FontSize="11" IsReadOnly="True"
                         Background="#FAFCFF" BorderBrush="#D3E2F0" BorderThickness="1"
                         Padding="8"/>
            </Grid>
        </DockPanel>
    </Border>
</mah:MetroWindow>
